# Google Sheets API key (from Google Cloud Console -> APIs & Services -> Credentials)
# Requires the Google Sheets API to be enabled for the same project.
GOOGLE_SHEETS_API_KEY=your_api_key_here

# Google Sheet: contains all tabs — Home Dashboard, Index-1, Index-2, Index-3, Index-4
# Must be shared as "Anyone with the link -> Viewer" for the API key to read it.
GOOGLE_SHEET_1_ID=your_sheet_id_here

# Optional: revalidation window in seconds for server-side cache
REVALIDATE_SECONDS=8
